{
  "name": "exact-online-mcp",
  "version": "0.1.0",
  "description": "MCP server voor Exact Online (REST API)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exact-online-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "login": "npm run build && node dist/login.js",
    "start": "node dist/index.js",
    "start:http": "node dist/httpApp.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "open": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
