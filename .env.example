# Exact Online App-registratie (zie README voor hoe je deze aanmaakt op
# https://apps.exactonline.com)
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=

# Redirect URI zoals geregistreerd bij je Exact app. Moet exact overeenkomen,
# inclusief poort. Standaard gebruikt de login-flow poort 8934.
EXACT_REDIRECT_URI=http://localhost:8934/callback

# Land/regio van je Exact Online omgeving. Bepaalt het API-basisadres.
# Opties: nl, be, de, fr, uk, es, us (zie README voor de volledige lijst).
EXACT_COUNTRY=nl

# Optioneel: vaste division (administratienummer). Als leeg, gebruikt de
# server automatisch de "current division" van de ingelogde gebruiker.
EXACT_DIVISION=

# Zet op "true" om schrijf-acties (aanmaken/wijzigen/verwijderen) toe te
# staan. Standaard "false" = alleen-lezen, veiligste optie.
ALLOW_WRITE=false

# Waar tokens lokaal worden opgeslagen (JSON-bestand, niet in git zetten!)
TOKEN_STORE_PATH=./tokens.json

# --- Alleen nodig voor de HTTP-variant (dist/httpApp.js), bv. op Plesk voor
# gebruik met Microsoft Copilot Studio. Niet nodig voor lokaal stdio-gebruik
# met Claude Code/Desktop.

# Sleutel die Copilot Studio moet meesturen (header "X-API-Key", of
# "Authorization: Bearer <key>") om het /mcp endpoint te mogen gebruiken.
# Genereer iets langs en willekeurigs, bv. met: openssl rand -hex 32
MCP_API_KEY=

# Sleutel die je zelf in de browser meegeeft (?key=...) om /oauth/login te
# mogen starten, zodat niet iedereen die de URL raadt kan proberen in te
# loggen bij jouw Exact-omgeving.
ADMIN_SETUP_KEY=

# Poort waarop de HTTP-server luistert (Plesk/Passenger regelt de externe
# routering hier zelf naartoe, dus dit hoeft meestal niet aangepast).
PORT=3000
